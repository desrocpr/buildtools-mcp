# ---------------------------------------------------------------------------
# stdio transport — per-user install (Claude Desktop)
# ---------------------------------------------------------------------------
# Required when running the default stdio transport. Each Claude Desktop user
# sets these in their OWN claude_desktop_config.json env block — do NOT share
# credentials across users. (Push to Doppler buildtools-mcp/dev|prd.)
BUILDTOOLS_TENANT=moss
BUILDTOOLS_USERNAME=
BUILDTOOLS_PASSWORD=

# ---------------------------------------------------------------------------
# HTTP/SSE transport (Phase 6, MOS-220) — hosted agent install
# ---------------------------------------------------------------------------
# Set MCP_TRANSPORT=http to switch from stdio to HTTP/SSE. Default is stdio,
# so leaving this unset keeps the Claude Desktop install behavior intact.
#MCP_TRANSPORT=stdio

# Port the HTTP transport listens on. Defaults to 3030 when MCP_TRANSPORT=http.
HTTP_PORT=

# Bearer token enforced on every HTTP request. REQUIRED when MCP_TRANSPORT=http;
# the process exits non-zero at startup if missing. Distribute this token to
# trusted MCP clients only — it grants the right to *connect*, not the right
# to access BuildTools. Each connected SSE session must additionally call the
# `set_session_credentials` tool with its OWN BuildTools username + password
# before any BuildTools-bound tool will run for that session.
HTTP_BEARER_TOKEN=

# Optional: when MCP_TRANSPORT=http, BUILDTOOLS_TENANT acts as the default
# tenant for sessions that omit the `tenant` arg in set_session_credentials.
# BUILDTOOLS_USERNAME / BUILDTOOLS_PASSWORD are NOT read by the HTTP transport
# — credentials come from each session's handshake instead.
